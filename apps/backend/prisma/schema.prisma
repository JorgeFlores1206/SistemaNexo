generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
}

enum EstadoGeneracionReporte {
  EN_PROCESO
  GENERADO
  VACIO
  FALLIDO

}

enum RolUsuario {
  ADMINISTRADOR
  USUARIO

}

model Usuario {
  id          String   @id @default(uuid())
  nombre      String
  correo      String   @unique
  rol         RolUsuario
  activo      Boolean  @default(true)
  passwordHash String?
  debeCambiarPassword Boolean @default(true)
  ultimoAcceso DateTime?
  creadoEn    DateTime @default(now())
  actualizadoEn DateTime @updatedAt
  sesiones    Sesion[]
  ajustes     AjusteInventario[]

  @@index([activo, rol])
}

model Sesion {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  usuarioId   String
  expiraEn    DateTime
  revocadaEn  DateTime?
  creadaEn    DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, revocadaEn])
  @@index([expiraEn])
}

model BitacoraEvento {
  id             String   @id @default(uuid())
  fecha          DateTime @default(now())
  actor          String
  accion         String
  detalle        String
  resultado      String
  cuentaAfectada String?

  @@index([fecha])
  @@index([accion])
}

model Producto {
  id                 String   @id @default(uuid())
  codigo             String   @unique
  nombre             String
  politicaDevolucion String?
  fechaEfectiva      DateTime?
  vencimientoOriginal DateTime?
  estadoCalculado    String?
  danado             Boolean  @default(false)
  onHand             Int?
  saldo              Int?
  activo             Boolean  @default(true)
  version            Int      @default(1)
  arqueo             String?
  uomPrimaria        String?
  laboratorio        String?
  marca              String?
  filasReporte       ProductoProximoAVencer[]
  ajustes            AjusteInventario[]
  creadoEn           DateTime @default(now())
  actualizadoEn      DateTime @updatedAt

}

model AjusteInventario {
  id            String   @id @default(uuid())
  productoId    String
  actorId       String
  saldoAnterior Int
  saldoNuevo    Int
  motivo        String
  fecha         DateTime @default(now())
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  actor         Usuario  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([productoId, fecha])
  @@index([actorId, fecha])
}

model ReporteMensualVencimientos {
  id                 String   @id @default(uuid())
  mesReferencia      DateTime @unique
  fechaNegocio       DateTime
  estadoGeneracion   EstadoGeneracionReporte
  cantidadIncluida   Int      @default(0)
  errorCodigo        String?
  errorMensaje       String?
  generadoEn         DateTime @default(now())
  productos          ProductoProximoAVencer[]
  bitacora           BitacoraReporteMensual[]

  @@index([estadoGeneracion])
}

model ProductoProximoAVencer {
  id                  String   @id @default(uuid())
  reporteId           String
  productoId          String
  codigo              String
  nombre              String
  politicaDevolucion  String?
  fechaEfectiva       DateTime?
  vencimientoOriginal DateTime
  fechaRelevante      DateTime
  estadoCalculado     String
  danado              Boolean
  diasRestantes       Int
  reporte             ReporteMensualVencimientos @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  producto            Producto @relation(fields: [productoId], references: [id])

  @@unique([reporteId, productoId])
  @@index([reporteId])
}

model BitacoraReporteMensual {
  id               String   @id @default(uuid())
  reporteId        String
  mesReferencia    DateTime
  fechaNegocio     DateTime
  resultado        EstadoGeneracionReporte
  cantidadIncluida Int
  creadoEn         DateTime @default(now())
  reporte          ReporteMensualVencimientos @relation(fields: [reporteId], references: [id], onDelete: Cascade)

  @@index([mesReferencia, creadoEn])
}
