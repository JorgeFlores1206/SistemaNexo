{
  "name": "nexo",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {"build": "turbo run build", "lint": "turbo run lint", "test": "turbo run test", "format:check": "prettier --check .", "db:generate": "npm run db:generate -w apps/backend", "db:push": "npm run db:push -w apps/backend", "db:seed": "npm run db:seed -w apps/backend", "desktop": "npm run build && npm run start -w apps/desktop"},
  "devDependencies": {"prettier": "3.9.10", "turbo": "2.11.8", "typescript": "5.9.3"},
  "engines": {"node": ">=24 <25", "npm": ">=11"}
}
