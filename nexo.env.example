# Copia este archivo como "nexo.env" junto al ejecutable de escritorio (o en la raíz
# del proyecto en desarrollo) y completa los valores reales. "nexo.env" nunca se sube
# a git (ver .gitignore).
DATABASE_URL=postgresql://usuario:password@host:5432/postgres?schema=nexo
DIRECT_URL=postgresql://usuario:password@host:5432/postgres?schema=nexo
SESSION_SECRET=reemplaza-esto-con-un-valor-aleatorio-largo
PORT=3000
